# SADEN — variáveis de ambiente (copie para .env e ajuste)
PORT=3001
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h
DATABASE_PATH=data/saden.db
FRONTEND_ORIGIN=http://localhost:3001
YAHOO_UA=SADEN-TCC/0.1 (contato-academico)
HTTP_TIMEOUT_MS=12000
CACHE_PRICES_TTL_MIN=60
CACHE_WEATHER_TTL_MIN=60
CACHE_GEO_TTL_DAYS=30
# Recuperação de senha: sem SMTP configurado, as mensagens vão para
# tmp/mail-outbox/ (desenvolvimento/teste). Para produção, defina SMTP_HOST
# e implemente o transporte em backend/src/services/mailService.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
