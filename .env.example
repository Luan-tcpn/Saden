# SADEN — variáveis de ambiente (copie para .env e ajuste)
# Nunca comite o .env. Este arquivo é o modelo, sem segredos reais.

# ---- aplicação (web) ----
PORT=3001
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h
DATABASE_PATH=data/saden.db
FRONTEND_ORIGIN=http://localhost:3001

# ---- fontes externas ----
YAHOO_UA=SADEN-TCC/0.1 (contato-academico)
HTTP_TIMEOUT_MS=12000
CACHE_PRICES_TTL_MIN=60
CACHE_WEATHER_TTL_MIN=60
CACHE_GEO_TTL_DAYS=30

# ---- operação (Release 2) ----
# Quem pode consultar /api/ops/status (lista separada por vírgula).
# Vazio = ninguém (padrão seguro).
SADEN_ADMIN_EMAILS=

# Hora local (America/Sao_Paulo) da verificação diária do worker.
SADEN_WORKER_HOUR=18
# Intervalo mínimo entre consultas da MESMA série (proteção do provedor).
SADEN_WORKER_MIN_SERIES_MS=3600000
# TTL do lease do job; precisa ser maior que um ciclo normal.
SADEN_WORKER_LOCK_TTL_MS=300000
# Intervalo do heartbeat do processo.
SADEN_WORKER_HEARTBEAT_MS=20000
# Dias corridos de tolerância de frescor (cobre fim de semana + feriado).
SADEN_STALE_AFTER_DAYS=4
# 0 desabilita o ciclo inicial no start do worker.
SADEN_WORKER_RUN_ON_START=1
# Histórico de execuções mantido (padrão 500 ≈ 23 meses de dias úteis).
SADEN_WORKER_RUNS_KEEP=500

# ---- monitoramento externo (opcional) ----
# URL de ping do Healthchecks.io (ou compatível). Contém token: NÃO comite.
# Vazio = desabilitado. O worker envia /start, o sucesso na URL base e /fail.
# No painel, use período de 3 dias e grace de 6 h para não acusar fim de semana.
SADEN_MONITOR_PING_URL=
SADEN_MONITOR_TIMEOUT_MS=5000

# ---- backup ----
# Retenção em arquivos; a poda só ocorre depois de validar o novo backup.
SADEN_BACKUP_RETENTION=14
# Intervalo entre backups do serviço saden-backup (segundos).
SADEN_BACKUP_INTERVAL_SECONDS=86400
# Diretório de saída quando rodando fora do Docker.
SADEN_BACKUP_DIR=data/backups
# Acima disso o healthcheck considera o backup atrasado (24h + 6h de tolerância).
SADEN_BACKUP_MAX_AGE_HOURS=30

# Monitor próprio do BACKUP (identificador diferente do worker). Contém token.
SADEN_BACKUP_MONITOR_PING_URL=

# ---- off-site (opcional) ----
# disabled | dir | s3. Sem credenciais o backup local continua normal.
SADEN_OFFSITE_MODE=disabled
# modo dir: diretório espelhado (teste/simulação)
SADEN_OFFSITE_DIR=
# quantos objetos manter no destino remoto
SADEN_OFFSITE_RETENTION=14
# 1 = cifra antes de enviar (recomendado). 0 só é aceitável em teste local.
SADEN_BACKUP_ENCRYPT=1
# Passphrase da criptografia (mínimo 12 caracteres). NÃO comite.
# Perder esta chave = perder as cópias remotas. Guarde fora do servidor.
SADEN_BACKUP_PASSPHRASE=

# modo s3 (compatível com Backblaze B2, Cloudflare R2, MinIO, AWS)
SADEN_S3_ENDPOINT=
SADEN_S3_BUCKET=
SADEN_S3_REGION=us-east-1
SADEN_S3_ACCESS_KEY=
SADEN_S3_SECRET_KEY=
SADEN_S3_PREFIX=saden/backups

# ---- e-mail (recuperação de senha) ----
# Sem SMTP configurado, as mensagens vão para tmp/mail-outbox/ (desenvolvimento).
# Para produção, defina SMTP_* e implemente o transporte em
# backend/src/services/mailService.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
