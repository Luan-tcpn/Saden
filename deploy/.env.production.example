# SADEN — ambiente de PRODUÇÃO (modelo)
# Copie para /srv/saden/.env, preencha e aplique: chmod 600 .env
# NUNCA comite este arquivo preenchido.

# ---- imagem (imutável) ----
# Use tag + digest para garantir exatamente o código auditado:
#   docker buildx imagetools inspect ghcr.io/<org>/saden:1.2.3
# Exemplo: SADEN_IMAGE=saden:1.2.3@sha256:<64 hex>
SADEN_IMAGE=

# ---- domínio e TLS ----
SADEN_DOMAIN=saden.exemplo.com.br
ACME_EMAIL=operacao@exemplo.com.br
CADDY_IMAGE=caddy:2.8-alpine

# ---- autenticação ----
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Administrador que pode ver /api/ops/status. Vazio = ninguém.
SADEN_ADMIN_EMAILS=

# ---- worker ----
SADEN_WORKER_HOUR=18
SADEN_WORKER_MIN_SERIES_MS=3600000
SADEN_WORKER_LOCK_TTL_MS=300000
SADEN_WORKER_RUNS_KEEP=500
SADEN_STALE_AFTER_DAYS=4

# ---- monitoramento externo (Healthchecks.io) ----
# Dois checks INDEPENDENTES. Sem URL, o recurso fica desabilitado.
# Worker: período 3 dias, grace 6 h (não acusa fim de semana).
SADEN_MONITOR_PING_URL=
# Backup: período 1 dia, grace 6 h (ciclo de 24 h).
SADEN_BACKUP_MONITOR_PING_URL=

# ---- backup local ----
SADEN_BACKUP_RETENTION=14
SADEN_BACKUP_INTERVAL_SECONDS=86400
SADEN_BACKUP_MAX_AGE_HOURS=30

# ---- backup off-site (criptografado) ----
# disabled | s3   (o modo `dir` é apenas para testes locais)
SADEN_OFFSITE_MODE=s3
SADEN_OFFSITE_RETENTION=14
SADEN_BACKUP_ENCRYPT=1
# Passphrase >= 12 caracteres. GUARDE FORA DO SERVIDOR (gerenciador de senhas).
# Perder esta chave = perder as cópias remotas. Não há recuperação.
SADEN_BACKUP_PASSPHRASE=

# Backblaze B2  -> endpoint  https://s3.<região>.backblazeb2.com
# Cloudflare R2 -> endpoint  https://<account-id>.r2.cloudflarestorage.com
# AWS S3        -> endpoint  https://s3.<região>.amazonaws.com
SADEN_S3_ENDPOINT=
SADEN_S3_BUCKET=
SADEN_S3_REGION=
SADEN_S3_ACCESS_KEY=
SADEN_S3_SECRET_KEY=
SADEN_S3_PREFIX=saden/backups
