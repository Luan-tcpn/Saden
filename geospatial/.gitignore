.venv/
artifacts/
__pycache__/
*.pyc
.pytest_cache/
# V2.2 — dados brutos e derivados locais
# Planilhas da CONAB: acesso público, mas termos de uso ambíguos para
# redistribuição (decisão D48) — ficam fora do Git; URL + SHA-256 no manifesto.
data/raw/conab/
# V2.4 — CSVs brutos do ZARC (todo o Brasil, ~180 MB por safra): fora do Git;
# o recorte de Sorriso (data/processed/zarc/) é a evidência versionada.
data/raw/zarc/
# V2.4 — geometrias dos polígonos da CONAB (SUTIN): grandes (pixel-level) e
# reproduzíveis pela consulta WFS registrada no manifesto; versiona-se o CSV
# de atributos.
data/processed/conab_sutin/*.geojson
# Base normalizada em JSON: duplicata do CSV versionado (regenerável).
data/processed/*.json
# Achados completos de qualidade: CSV versionado guarda error/warning.
data/manifests/quality_findings_full.csv
# V2.6 - artefatos grandes e regeráveis (fora do Git; URL + manifesto):
# a serie diaria climatico tem centenas de MB por fonte, a base do ZARC multi-municipal (11 safras x 1.622 municípios) tem ~2 GB, a PAM
# multi-municipal ~430 MB e as malhas municipais ~160 MB. Todos são
# reconstruídos pelos comandos `run_agroclimate.py` (municipalities, stations,
# climate, quality, pam, zarc) e têm o manifesto correspondente versionado.
data/processed/climate_daily.csv
data/processed/climate_daily_audited.csv
data/processed/zarc_panel.csv
data/processed/pam_panel.csv
data/processed/panel_municipalities.geojson
data/manifests/climate_quality_full.json
# V2.7 - capabilities bruta do WCS da Embrapa Solos (~2,5 MB): e regeneravel
# por `tools/s27_wcs_probe.py`; a versao extraida (camadas, unidade, licenca)
# fica no manifesto versionado `v27_cad_wcs_probe.json`.
data/processed/embrapa_solos_wcs_capabilities.xml
# V3.0 - painel recalculado com a CAD oficial (~8,5 MB): derivado do painel da
# V2.6 + estatisticas de CAD; regeneravel por `tools/v30_recalculate_panel.py`.
# As estatisticas por municipio (a evidencia) ficam nos manifests versionados
# `v30_cad_polygon.json`/`.csv` e `v30_balance_recalc.json`.
data/processed/v30_panel_cad.csv
# V3.1 - painel com as duas janelas (legada e corrigida): derivado e regeneravel
# por tools/v31_rebuild_panel.py; a evidencia fica em v31_window_rebuild.json.
data/processed/v31_panel_windows.csv
# V3.2 - nenhum artefato binario novo; manifests ficam versionados
# V3.3 - descritores de estresse: derivado e regeneravel por
# tools/v33_water_variables.py; a evidencia fica em v33_water_variables.json.
data/processed/v33_water_variables.csv
# V3.4 - arquivos de terceiros baixados do sitio oficial (nao redistribuidos):
# o mapeamento derivado e o hash ficam em municipality_region_mapping.csv e
# v34_region_mapping.json.
data/external/
